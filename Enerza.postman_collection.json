        {
          "name": "Issue a bill (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) {",
                  "    pm.collectionVariables.set(\"billId\", body.data.id);",
                  "}"
                ]
              }
