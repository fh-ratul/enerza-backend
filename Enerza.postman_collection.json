  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dates the schedule and bill requests use (Asia/Dhaka, UTC+6).",
          "const dhaka = new Date(Date.now() + 6 * 60 * 60 * 1000);",
          "pm.collectionVariables.set(\"thisMonth\", dhaka.toISOString().slice(0, 7));",
          "pm.collectionVariables.set(\"tomorrow\", new Date(dhaka.getTime() + 24 * 60 * 60 * 1000).toISOString().slice(0, 10));",
          "",
          "// Seeded grid ids, looked up once from the public feeder list.",
          "if (!pm.collectionVariables.get(\"areaId\")) {",
          "    pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/feeders?limit=100\", (error, response) => {",
          "        if (error || response.code !== 200) { return; }",
          "        const feeders = response.json().data;",
          "        const byCode = (code) => feeders.find((feeder) => feeder.code === code);",
          "        const mirpur = byCode(\"FD-MIR-01\"), pallabi = byCode(\"FD-MIR-02\"), uttara = byCode(\"FD-UTT-01\");",
          "        if (!mirpur || !pallabi || !uttara) { return; }",
          "        pm.collectionVariables.set(\"zoneId\", mirpur.substation.zone.id);",
          "        pm.collectionVariables.set(\"substationId\", uttara.substation.id);",
          "        pm.collectionVariables.set(\"areaId\", pallabi.areas.find((area) => area.code === \"AR-PALLABI\").id);",
          "        pm.collectionVariables.set(\"seedFeederId\", mirpur.id);",
          "        pm.collectionVariables.set(\"maintenanceFeederId\", uttara.id);",
          "        pm.collectionVariables.set(\"incidentFeederId\", pallabi.id);",
          "    });",
          "}"
        ]
      }
    }
  ],
