NODE_ENV=development
PORT=5000

# PostgreSQL connection string (Prisma Postgres direct TCP URL: postgres://...@db.prisma.io:5432/...).
# The app uses the pg driver adapter, so this must be a postgres:// URL, not prisma+postgres://.
DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Allowed CORS origin for the browser client.
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=

# Demo admin, created by `npx prisma db seed`.
ADMIN_NAME=Enerza Admin
ADMIN_EMAIL=admin@enerza.com
ADMIN_PASSWORD=

REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=

BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=http://localhost:5000/api/v1

# Gmail SMTP for notification emails: the account, a Google app password, and the "from" address.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=

# Cloudinary, for profile photos and outage report photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
