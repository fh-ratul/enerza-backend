{
	"name": "enerza-backend",
	"version": "1.0.0",
	"description": "Enerza — load shedding and power outage management system (REST API)",
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsup",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"format:check": "npx @biomejs/biome format ./src",
		"format:fix": "npx @biomejs/biome format --write ./src",
		"lint:check": "npx @biomejs/biome lint ./src",
		"lint:fix": "npx @biomejs/biome lint --write ./src"
	},
	"keywords": [
		"load-shedding",
		"outage-management",
		"express",
		"prisma",
		"bkash"
	],
	"author": "",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"http-status": "^2.1.0",
		"pg": "^8.23.1",
		"rate-limit-redis": "^6.0.1",
		"redis": "^6.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.1.2",
		"@types/pg": "^8.23.1",
		"prisma": "^7.10.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
