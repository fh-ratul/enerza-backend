model User {
  id                   String       @id @default(uuid(7))
  name                 String
  email                String       @unique
  password             String?
  googleId             String?      @unique
  authProvider         AuthProvider @default(CREDENTIAL)
  role                 Role         @default(CUSTOMER)
  status               UserStatus   @default(ACTIVE)
  // Cloudinary: the public id is kept so the old image can be removed on replace
  profilePhoto         String?
  profilePhotoPublicId String?
  isDeleted            Boolean      @default(false)
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customer   Customer?
  technician Technician?
  auditLogs  AuditLog[]
  schedules  Schedule[]       @relation("ScheduleCreator")
  timeline   OutageTimeline[]
  bills      Bill[]           @relation("BillIssuer")

  @@index([role, status, isDeleted])
  @@map("users")
}
